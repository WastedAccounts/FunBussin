# Smartwaiver API key - get one at https://app.smartwaiver.com/user/api/api-keys
SMARTWAIVER_API_KEY=your_api_key_here

# Mailchimp - API key from https://us1.admin.mailchimp.com/account/api/
# Server is the datacenter prefix from your admin URL (e.g. us19 from us19.admin.mailchimp.com)
# Can be omitted if your API key includes it (format: xxxxxxxx-us19)
# List ID from Audience settings > Audience name and defaults
MAILCHIMP_API_KEY=your_api_key_here
MAILCHIMP_SERVER=us19
MAILCHIMP_LIST_ID=your_list_id_here
